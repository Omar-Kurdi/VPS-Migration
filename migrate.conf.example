# ============================================================================
# migrate.conf
#
# Copy this file to "migrate.conf" (same folder) and fill in your real
# values. 02-migrate.sh reads this file. You run 02-migrate.sh ON THE OLD
# VPS - it pushes files to the NEW VPS over SSH/rsync.
# ============================================================================

# SSH connection details for the NEW (destination) VPS, as reachable FROM
# the old VPS.
NEW_HOST="new.server.ip.or.hostname"
NEW_USER="root"
NEW_SSH_PORT="22"
# ABSOLUTE path (ON THE OLD VPS) to the PRIVATE key that logs into the NEW
# VPS - e.g. "/root/.ssh/migrate_key", not "migrate_key.pub". Find it with:
#   readlink -f ~/.ssh/migrate_key
# It must be absolute. This file is sourced, so "~/.ssh/migrate_key" stays a
# literal tilde that ssh cannot resolve, and you get a confusing auth failure.
# Leave blank to use ssh-agent / the default key.
NEW_SSH_KEY=""

# Preview mode. "yes" runs every rsync with --dry-run and skips the remote
# package install and the database dumps - nothing on either box is changed.
# Run once with this set to yes to confirm NEW_HOST is really the box you
# think it is before pushing files to / as root.
DRY_RUN="no"

# Install the old box's packages on the new box BEFORE copying configs over.
# This ordering matters: if configs land first and packages are installed
# afterwards, dpkg has to decide what to do with config files it doesn't have
# a record of - not a decision you want to leave to a prompt default during a
# server migration. Installing first means the copied configs land last and win.
# Set to "no" only if you have already provisioned the new box yourself.
INSTALL_PACKAGES="yes"

# The old VPS's public IP. Left blank, it is read from meta.env, which
# 01-discover.sh writes after auto-detecting it. 03-post-migrate.sh greps the
# copied configs for this address, since it is hardcoded in more places than
# you remember (nginx listen directives, squid ACLs, fail2ban ignoreip,
# wireguard, monitoring agents).
OLD_IP=""

# Set to "yes" to also copy full /home directories (can be large / contain
# personal files you may not want moved wholesale). Default: no.
COPY_HOME_DIRS="no"

# Any extra files or folders to copy that the standard list misses - your
# own scripts, custom tools, one-off configs (e.g. ./jails.sh). Check
# inventory.txt's "CUSTOM / PERSONAL SCRIPTS" section for candidates, then
# list their FULL absolute paths here, one per line, inside the parentheses.
# 02-migrate.sh copies /root, /usr/local/bin, /usr/local/sbin and /opt by
# default already - this is for anything outside those, e.g. things in a
# non-root user's home directory or somewhere unusual.
EXTRA_PATHS=(
  # "/root/jails.sh"
  # "/home/myuser/scripts"
)

# Databases. "auto" (the default) means: if a database server is installed and
# reachable on this box, dump it and copy it; if none is installed, skip
# quietly; if one IS installed but can't be reached, say so loudly rather than
# skipping silently. You do not need to know what you're running.
#
# Dumping is read-only and cannot lose data - the risky step is the import,
# and 03-post-migrate.sh leaves that manual for you to run deliberately.
#
# Use "yes" to force a dump attempt, or "no" to skip entirely (e.g. you're
# migrating the database separately, or it's too large to move this way).
DUMP_MYSQL="auto"
DUMP_POSTGRES="auto"
